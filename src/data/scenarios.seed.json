{
  "version": 2,
  "scenarios": [
    {
      "id": "boss_001",
      "version": 2,
      "category": "boss",
      "character": "linda_micromanager",
      "text": "Linda appears at your desk at 4:59 PM on Friday. \"Got a minute?\" she asks, blocking your escape route.",
      "choices": [
        {
          "id": "boss_001_a",
          "text": "Fake an urgent phone call",
          "consequence": "Your phone wasn't even on. Linda saw everything.",
          "statModifiers": { "reputation": -15, "chaos": 5, "stealth": -10 },
          "sfx": "sad_trombone"
        },
        {
          "id": "boss_001_b",
          "text": "Accept your fate",
          "consequence": "It was just about the TPS reports. But now you're here until 6.",
          "statModifiers": { "reputation": 5, "chaos": 0, "stealth": 0 },
          "sfx": "none"
        },
        {
          "id": "boss_001_c",
          "text": "Pretend to be on an important video call",
          "consequence": "You're not wearing headphones. Nice try.",
          "statModifiers": { "reputation": -10, "chaos": 10, "stealth": -5 },
          "sfx": "record_scratch"
        }
      ]
    },
    {
      "id": "boss_002",
      "version": 2,
      "category": "boss",
      "character": "linda_micromanager",
      "text": "Linda sends you a meeting invite for 8 AM tomorrow titled \"Quick Sync\". No agenda. No context.",
      "choices": [
        {
          "id": "boss_002_a",
          "text": "Accept immediately to seem eager",
          "consequence": "She noticed you accepted in 3 seconds. Now she thinks you have no work.",
          "statModifiers": { "reputation": -5, "chaos": 0, "stealth": -10 },
          "sfx": "none"
        },
        {
          "id": "boss_002_b",
          "text": "Wait 2 hours before accepting",
          "consequence": "Power move. Linda respects the game.",
          "statModifiers": { "reputation": 5, "chaos": 0, "stealth": 10 },
          "sfx": "cash_register"
        },
        {
          "id": "boss_002_c",
          "text": "Reply asking for an agenda",
          "consequence": "Linda doesn't believe in agendas. Now you're on The List.",
          "statModifiers": { "reputation": -10, "chaos": 5, "stealth": 0 },
          "sfx": "suspense_sting"
        }
      ]
    },
    {
