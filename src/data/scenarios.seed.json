        {
          "id": "boss_003_c",
          "text": "Pretend your internet is cutting out",
          "consequence": "Linda sees you're still on Slack. Awkward.",
          "statModifiers": { "reputation": -15, "chaos": 5, "stealth": -5 },
          "sfx": "record_scratch"
        }
      ]
    },
